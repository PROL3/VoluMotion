<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#f5f5f5">

    <!-- כותרת -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎙️ Hand Gesture Volume Control"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="30dp"
        android:textColor="#333333" />

    <!-- תאור -->
    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="שלוט בעוצמת השמע דרך סיבוב היד:\n↻ סיבוב כלפי יָמִין = עוצמה ↑\n↺ סיבוב כלפי שמאל = עוצמה ↓"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="30dp"
        android:textColor="#666666"
        android:background="@drawable/rounded_background"
        android:padding="15dp" />

    <!-- סטטוס -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="סטטוס: כבוי"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:textColor="#333333" />

    <!-- טוגל הפעלה -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="הפעל שירות:"
            android:textSize="16sp"
            android:textColor="#333333" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/toggleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- כפתור Pause/Resume -->
    <Button
        android:id="@+id/pauseButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="השהה ניטור"
        android:enabled="false"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_background"
        android:textColor="#ffffff" />

    <!-- הרשאות -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="15dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הרשאות נדרשות:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Camera - לגישה למצלמה\n📍 Location - לזיהוי נהיגה\n🔊 Audio - לשליטה בווליום"
            android:textSize="12sp"
            android:textColor="#666666"
            android:lineSpacingExtra="5dp" />
    </LinearLayout>

    <!-- טיפים -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 טיפים:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• השתמש בתאורה טובה לתוצאות מיטביות\n• הצב את הטלפון במרחק 30-50 ס&quot;מ מפניך\n• סיבוב איטי וחלק עדיף על סיבוב מהיר\n• האפליקציה מופעלת אוטומטית בזמן נהיגה"
            android:textSize="12sp"
            android:textColor="#666666"
            android:lineSpacingExtra="5dp" />
    </LinearLayout>

</LinearLayout>
